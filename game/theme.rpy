## Building blocks for the game's own screens ##################################

## Glossy pill button. kind: pink (primary), white (secondary), plum, violet, gold.
screen pill_button(label_text, action, kind="pink", size=30, sensitive=True, xsize=None):
    $ fg = THEME_PLUM if kind == "white" else "#ffffff"
    button at pop_hover:
        background ui_pill(kind)
        hover_background ui_pill("violet" if kind == "pink" else "pink")
        insensitive_background ui_pill("white")
        padding (30, 10, 30, 14)
        if xsize:
            xsize xsize
        sensitive sensitive
        action action
        text label_text:
            xalign 0.5
            size size
            color fg
            hover_color "#ffffff"
            insensitive_color "#3a164055"
            outlines (OUTLINE_SMALL if fg == "#ffffff" else [])
            hover_outlines OUTLINE_SMALL
            insensitive_outlines []

## A character's name on a pill in her signature color.
## Unmet characters show as "?" (CLAUDE.md §5).
screen char_chip(cid, size=26):
    $ known = store.gs is None or has_flag("met_" + cid)
    frame:
        background (namebox_bg(cid) if known else namebox_bg("default"))
        padding (24, 4, 24, 8)
        text (cname(cid) if known else "?") size size color "#ffffff" outlines OUTLINE_SMALL

## Row of heart images.
screen hearts(n, total=5, size=1.0):
    hbox:
        spacing 4
        for d in hearts_row(n, total, size):
            add d

## Big white outlined heading.
screen heading(t, size=60):
    text t size size color "#ffffff" outlines OUTLINE_MED xalign 0.5 text_align 0.5
