## Visual theme: glossy candy dating-sim look (pink/violet gradients, rounded
## glossy panels, pill buttons, hearts, chunky outlined text).
##
## The art is generated by scripts/make_ui_art.py into game/gui/ and
## game/gui/theme/. This file applies it on top of Ren'Py's default screens
## (screens.rpy) and supplies helpers for the game's own screens.
## Loads after screens.rpy, so the style statements here win.

init -2 python:

    THEME_PINK = "#ff5fa2"
    THEME_HOT = "#ff2f86"
    THEME_PINK_LIGHT = "#ffc6df"
    THEME_BLUSH = "#ffe9f3"
    THEME_PLUM = "#3a1640"
    THEME_PLUM2 = "#62246a"
    THEME_VIOLET = "#8b5cf6"
    THEME_CREAM = "#fff8fc"
    THEME_MUTED = "#8a6f86"
    THEME_GOLD = "#ffd84d"

    # Chunky outlined text: white letters with a plum outline and a soft drop.
    OUTLINE_BIG = [(6, THEME_PLUM, 0, 0), (6, "#3a164066", 0, 5)]
    OUTLINE_MED = [(4, THEME_PLUM, 0, 0), (4, "#3a164055", 0, 3)]
    OUTLINE_SMALL = [(3, THEME_PLUM, 0, 0)]
    OUTLINE_PINK = [(4, THEME_HOT, 0, 0)]

    def ui_panel(kind="panel"):
        """Rounded glossy panel: 'panel', 'panel_dark'."""
        return Frame("gui/theme/%s.png" % kind, 46, 46)

    def ui_card(kind="card"):
        """Lighter, flatter card: 'card', 'card_hover', 'card_off'."""
        return Frame("gui/theme/%s.png" % kind, 32, 32)

    def ui_pill(kind="pink"):
        """Pill button background: 'pink', 'white', 'plum', 'violet', 'gold'."""
        return Frame("gui/theme/pill_%s.png" % kind, 36, 30, 36, 30)

    def namebox_bg(cid):
        name = cid if renpy.loadable("gui/theme/namebox_%s.png" % cid) else "default"
        return Frame("gui/theme/namebox_%s.png" % name, 34, 30, 34, 30)

    def hearts_row(n, total=5, size=1.0):
        """An hbox-ready list of heart images (filled then empty)."""
        full = Transform("gui/theme/heart_small.png", zoom=size)
        empty = Transform("gui/theme/heart_empty.png", zoom=size)
        return [full] * n + [empty] * (total - n)


## Transforms ##################################################################

transform pop_hover:
    on idle:
        ease .12 zoom 1.0
    on hover:
        ease .12 zoom 1.04
    on selected_idle:
        ease .12 zoom 1.0

transform title_bob:
    yoffset 0
    ease 1.6 yoffset -10
    ease 1.6 yoffset 0
    repeat

transform heart_beat:
    zoom 1.0
    ease .18 zoom 1.15
    ease .22 zoom 1.0
    pause 1.2
    repeat

transform notify_pop:
    on show:
        alpha 0 zoom .6 yoffset -10
        easein_back .35 alpha 1 zoom 1.0 yoffset 0
    on hide:
        ease .4 alpha 0 yoffset -20


## Dialogue box ################################################################

style window:
    left_margin 140
    right_margin 140
    bottom_margin 14
    bottom_padding 58

style say_dialogue:
    color THEME_PLUM
    outlines []

style say_label:
    color "#ffffff"
    outlines OUTLINE_SMALL
    xalign 0.5

style namebox:
    background namebox_bg("default")
    xminimum 220
    yminimum 66


## Choices #####################################################################

style choice_button:
    background Frame("gui/button/choice_idle_background.png", 70, 40, 70, 46)
    hover_background Frame("gui/button/choice_hover_background.png", 70, 40, 70, 46)

style choice_button_text:
    outlines []
    hover_outlines OUTLINE_SMALL


